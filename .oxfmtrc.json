{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "objectWrap": "preserve",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortPackageJson": true,
  "sortImports": {
    "internalPattern": ["@/"],
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "sortTailwindcss": {
    "stylesheet": "./app/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": ["drizzle/meta/**", "CHANGELOG.md"]
}
