{
  "name": "sparelay",
  "version": "0.2.0",
  "private": true,
  "keywords": [
    "llm",
    "mcp",
    "nextjs",
    "openwebui",
    "rag",
    "search",
    "search-api",
    "self-hosted"
  ],
  "homepage": "https://github.com/sparelay/sparelay",
  "bugs": {
    "url": "https://github.com/sparelay/sparelay/issues"
  },
  "license": "MIT",
  "author": "Sparelay contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparelay/sparelay.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bun .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@conform-to/react": "^1.21.2",
    "@conform-to/zod": "^1.21.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
